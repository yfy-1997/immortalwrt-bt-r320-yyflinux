// 声明设备树源码的版本为 v1
/dts-v1/;
// 引入必要的头文件，定义了 GPIO、按键输入和 LED 的常用宏
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

// 引入 MT7981B 芯片的基础定义文件（SoC 公用的寄存器、中断等都在这里面）
#include "mt7981b.dtsi"

/ {
	model = "BT R320";
	compatible = "bt,r320", "mediatek,mt7981";
  
  // 定义别名，方便其他节点引用
	aliases {
		serial0 = &uart0;
		label-mac-device = &gmac0;
	};

  // 存放由 Bootloader（如 U-Boot）传递给内核的参数
	chosen {
		bootargs = "root=PARTLABEL=rootfs rootwait";
		stdout-path = "serial0:115200n8";
	};
  
  // 定义物理内存信息
	memory {
    // 这里表示内存从 0x40000000 开始，大小为 0x40000000（即 1GB）
		reg = <0 0x40000000 0 0x40000000>;
	};

  // 定义 GPIO 按键（物理按钮）
	gpio-keys {
		compatible = "gpio-keys";

    // WPS 按键节点
		button-wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pio 0 GPIO_ACTIVE_LOW>;
		};

    // Reset 复位按键节点
		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
		};
	};

  // 定义 GPIO LED（指示灯）
	gpio-leds {
		compatible = "gpio-leds";

    // 2.4G WiFi 指示灯 LED 颜色为绿色
		wlan2g_led: led-0 {
			function = LED_FUNCTION_WLAN_2GHZ;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pio 34 GPIO_ACTIVE_LOW>;
		};

    // 5G WiFi 指示灯 LED 颜色为绿色
		wlan5g_led: led-1 {
			function = LED_FUNCTION_WLAN_5GHZ;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pio 35 GPIO_ACTIVE_LOW>;
		};
	};
};

// 引用并配置以太网控制器节点（&eth 定义在 mt7981b.dtsi 中）
&eth {
	status = "okay";
	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "2500base-x";
        nvmem-cells = <&macaddr_factory_2a 0>;
        nvmem-cell-names = "mac-address";
		fixed-link {
			speed = <2500>;
			full-duplex;
			pause;
		};
	};	
		gmac1: mac@1 {
		compatible = "mediatek,eth-mac";
		reg = <1>;
		phy-mode = "gmii";
		phy-handle = <&int_gbe_phy>;
	};

	mdio: mdio-bus {
		#address-cells = <1>;
		#size-cells = <0>;

    // 定义交换机芯片节点
		switch@0 {
			compatible = "mediatek,mt7531";
			reg = <31>;
			reset-gpios = <&pio 39 0>;

      // 定义交换机的各个端口
			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@1 {
					reg = <1>;
					label = "lan1";
				};

				port@2 {
					reg = <2>;
					label = "lan2";
				};

				port@3 {
					reg = <3>;
					label = "lan3";
				};

				port@4 {
					reg = <4>;
					label = "wan";
                    nvmem-cells = <&macaddr_factory_24 0>;
                    nvmem-cell-names = "mac-address";
				};
				
				port@6 {
					reg = <6>;
					label = "cpu";
					ethernet = <&gmac0>;
					phy-mode = "2500base-x";

					fixed-link {
						speed = <2500>;
						full-duplex;
						pause;
					};
				};
			};
		};
	};
};

// 引用并配置 eMMC 存储控制器（BT-R320 的 128GB 大容量存储就在这里配置）
&mmc0 {
	status = "okay";

	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	bus-width = <8>;
	max-frequency = <52000000>;
	vmmc-supply = <&reg_3p3v>;
	cap-mmc-highspeed;
	non-removable;
	no-sd;
	no-sdio;

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

    // eMMC 存储卡节点
		block {
			compatible = "block-device";

			partitions {
				block-partition-factory {
					partname = "factory";

					nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <1>;
						#size-cells = <1>;

						eeprom_factory_0: eeprom@0 {
							reg = <0x0 0x1000>;
						};

						macaddr_factory_24: macaddr@24 {
							compatible = "mac-base";
							reg = <0x24 0x6>;
							#nvmem-cell-cells = <1>;
						};

						macaddr_factory_2a: macaddr@2a {
							compatible = "mac-base";
							reg = <0x2a 0x6>;
							#nvmem-cell-cells = <1>;
						};
					};
				};
			};
		};
	};
};

// 引用并配置 GPIO 引脚控制器
&pio {
	mmc0_pins_default: mmc0-pins-default {
		mux {
			function = "flash";
			groups = "emmc_45";
		};
	};

	mmc0_pins_uhs: mmc0-pins-uhs {
		mux {
			function = "flash";
			groups = "emmc_45";
		};
	};
};

&uart0 {
	status = "okay";
};

// 启用硬件看门狗（防止系统死机）
&watchdog {
	status = "okay";
};

// 启用无线 WiFi 模块
&wifi {
	nvmem-cells = <&eeprom_factory_0>;
	nvmem-cell-names = "eeprom";
	status = "okay";
};

// 启用 USB 物理层
&usb_phy {
	status = "okay";
};

// 启用 USB 3.0 控制器（支持外接 U 盘、硬盘等）
&xhci {
	status = "okay";
};
